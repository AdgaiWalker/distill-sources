      {
        "author_id": "44936471",
        "conversation_id": "2091907378488680582",
        "created_at": "2026-08-24T15:15:59.000Z",
        "edit_history_tweet_ids": [
          "2091907378488680582"
        ],
        "id": "2091907378488680582",
        "lang": "en",
        "note_tweet": {
          "text": "After about a ~decade with atomic CSS frameworks (BuzzFeed Solid, Basscss, and then finally Tailwind), I think I'm convinced now that Stylex is superior for agents. \n\nStylex constraints lead to greater consistency and  correctness as your codebase grows. I do still think Tailwind is the ideal human DSL for styling, but in a world where I'm barely touching CSS/class names by hand, the tradeoffs have changed. Again, if I were still hand writing code, Tailwind still wins, but we're not doing that anymore."
        },
        "public_metrics": {
          "bookmark_count": 807,
          "impression_count": 359759,
          "like_count": 1509,
          "quote_count": 45,
          "reply_count": 81,
